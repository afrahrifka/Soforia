{
  "name": "main-bareng",
  "version": "0.1.0-beta.3",
  "private": true,
  "type": "module",
  "description": "Konsol game LAN offline untuk dua orang, dengan controller browser HP",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "dev": "npm run build && npm start",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "package:offline": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
