{
  "name": "main-bareng",
  "version": "0.1.0-beta.3",
  "private": true,
  "type": "module",
  "description": "Konsol game LAN offline untuk dua orang, dengan controller browser HP",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "dev": "npm run build && npm start",
    "check": "node scripts/generate-games.mjs && node scripts/check-boundaries.mjs && tsc --noEmit",
    "test": "node scripts/test.mjs",
    "package:offline": "npm run build && node scripts/package.mjs",
    "commit": "cz",
    "generate": "node scripts/generate-games.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:scope": "node scripts/check-scope.mjs",
    "game:new": "node scripts/new-game.mjs",
    "ai:route": "node scripts/ai-route.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "postinstall": "node scripts/generate-games.mjs",
    "change:new": "node scripts/new-change.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "start:normal": "node dist/server.mjs",
    "start:tailscale": "node scripts/start-tailscale.mjs",
    "stop:tailscale": "node scripts/start-tailscale.mjs --stop"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.14",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.33",
    "postcss-selector-parser": "^7.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
